{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Houmi Studio",
  "version": "0.1.2",
  "identifier": "com.houmi.studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Houmi Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4317 https://houmi.sytes.net wss://houmi.sytes.net; img-src 'self' asset: http://asset.localhost http://127.0.0.1:4317 blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "icon": ["../src/assets/hero.png"],
    "externalBin": ["binaries/houmi-local"],
    "resources": [
      "../../backend/models/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}


