{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Houmi Studio",
  "version": "2.0.0",
  "identifier": "com.houmi.studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Houmi Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4317 http://127.0.0.1:4000 ws://127.0.0.1:4317 ws://127.0.0.1:4000 https://houmi.click wss://houmi.click; img-src 'self' asset: http://asset.localhost http://127.0.0.1:4317 http://127.0.0.1:4000 blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "icon": ["../src/assets/hero.png"],
    "externalBin": ["binaries/houmi-local"],
    "resources": [
      "../../backend/models/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldUWk1lcmZlcVdEbndhV0R2c2ZZZTV4b1N2VzR3L293a3F2K0V3eGl5M3hxYWhwV0h6VG42UjcK",
      "endpoints": [
        "https://houmi.click/api/system/tauri-update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}


