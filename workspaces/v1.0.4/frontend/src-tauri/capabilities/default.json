{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by Houmi Studio's local engine",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/houmi-local",
          "sidecar": true
        }
      ]
    }
  ]
}
