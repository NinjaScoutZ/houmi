# Gemini API Key for OCR (free from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: override model (default: gemini-3.6-flash)
# HOUMI_GEMINI_MODEL=gemini-2.5-flash
# Font/style judging uses this key for text-only JSON decisions. If empty,
# the backend falls back to the installed `agy` or `gemini` CLI.
# HOUMI_GEMINI_API_VERSION=v1beta

# Optional: Gemini Web Proxy URL (if running novel-translator-app proxy)
# GEMINI_WEB_PROXY_URL=http://localhost:15300

# Optional: auto-fallback to PaddleOCR when cloud OCR fails
# HOUMI_GEMINI_FALLBACK=paddleocr
