# Gemini API & Engine Configuration
# GOOGLE_API_KEY=AIzaSy... (Uncomment and set your Google AI Studio API Key to use Direct Google API)

# Optional: Fallback engine if Gemini is down (paddleocr, none)
HOUMI_GEMINI_FALLBACK=paddleocr

# GPU Execution Provider (CUDA = NVIDIA GPU, DirectML = AMD/Intel GPU, CPU = No GPU)
HOUMI_EXECUTION_PROVIDER=CUDA
