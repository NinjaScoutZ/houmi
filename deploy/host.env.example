# Copy to a secret-managed environment file; do not commit real values.
HOUMI_RUNTIME_MODE=host
HOUMI_HOST=127.0.0.1
HOUMI_PORT=4000
DATABASE_URL=postgresql+psycopg://houmi:change-me@127.0.0.1:5432/houmi
HOUMI_JWT_SECRET=replace-with-a-long-random-secret
HOUMI_WORKER_SHARED_SECRET=replace-with-a-different-long-random-secret
HOUMI_CORS_ORIGINS=https://studio.example.com

# Optional cloud OCR. Keep the real key in the secret manager, never in git.
# GOOGLE_API_KEY=replace-with-google-ai-studio-key
# HOUMI_GEMINI_MODEL=gemini-3.6-flash
# HOUMI_GEMINI_FALLBACK=paddleocr

# Worker process uses the same DATABASE_URL and worker secret:
# HOUMI_RUNTIME_MODE=worker
