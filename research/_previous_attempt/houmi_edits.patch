+# balloon tail (or a pointer/spike) rather than usable interior.
+_TAIL_CORE_RATIO = 0.55
+# Monotone re-growth threshold: once a contiguous core is found, rows adjacent to
+# it are re-admitted while the profile keeps widening toward the core.  This
+# preserves the balloon's rounded shoulders without letting the tail back in.
+_TAIL_REGROW_RATIO = 0.30
+
