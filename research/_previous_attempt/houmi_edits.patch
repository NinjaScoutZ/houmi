+def find_core_row_span(row_widths: tuple[int, ...] | list[int]) -> tuple[int, int]:
+    """Return the ``[y0, y1]`` row span of the balloon body, excluding the tail.
+
+    A speech balloon's tail is a narrow protrusion.  Because it is included in
+    the mask bounding box, both the vertical centre and the per-line width
+    budget get dragged toward it.  This isolates the widest *contiguous* run of
+    rows so a tail attached at either end is removed, then re-grows the span
+    while row widths increase monotonically toward the core.
+    """
+    widths = np.asarray(row_widths, dtype=np.int32)
+    if widths.size == 0:
+        return (0, 0)
+    peak = int(widths.max())
+    if peak <= 0:
+        return (0, int(widths.size) - 1)
+
+    core = widths >= peak * _TAIL_CORE_RATIO
+    indices = np.flatnonzero(core)
+    if indices.size == 0:
+        return (0, int(widths.size) - 1)
+
+    # Longest contiguous run of core rows.  Contiguity is what rejects a tail
+    # that happens to contain a few wide rows of its own.
+    split_at = np.flatnonzero(np.diff(indices) > 1) + 1
+    runs = np.split(indices, split_at)
+    best = max(runs, key=len)
+    y0, y1 = int(best[0]), int(best[-1])
+
+    regrow_floor = peak * _TAIL_REGROW_RATIO
+    while y0 > 0 and widths[y0 - 1] >= regrow_floor and widths[y0 - 1] <= widths[y0]:
+        y0 -= 1
+    last = int(widths.size) - 1
+    while y1 < last and widths[y1 + 1] >= regrow_floor and widths[y1 + 1] <= widths[y1]:
+        y1 += 1
+    return (y0, y1)
+
